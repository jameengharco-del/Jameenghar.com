<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Discover and request hourly, day-use and overnight stays with Daybnb by JameenGhar.">
<title>Daybnb by JameenGhar | Hourly, Day & Overnight Stays</title>
<style>
:root{--g:#064d2b;--g2:#0b6840;--o:#ff5a0a;--ink:#17251d;--muted:#64736a;--cream:#f6f8f5;--line:#e4eae5;--white:#fff}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ink);background:#fff}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.wrap{width:min(1160px,92%);margin:auto}
header{position:sticky;top:0;z-index:10;background:#fff;border-bottom:1px solid var(--line)}.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand img{width:205px;max-height:62px;object-fit:contain}.navlinks{display:flex;gap:20px;align-items:center;font-size:14px;font-weight:700}.btn{border:0;border-radius:10px;padding:12px 17px;background:var(--o);color:#fff;font-weight:800;cursor:pointer}.btn.green{background:var(--g)}.btn.outline{background:#fff;color:var(--g);border:1px solid #b9c8be}.hero{background:radial-gradient(ellipse at 80% 5%,#e3f1e7,transparent 42%),linear-gradient(130deg,#f7faf7,#fff);padding:62px 0}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:35px;align-items:center}.eyebrow{background:#e4f2e8;color:var(--g);font-size:12px;font-weight:900;letter-spacing:1px;padding:8px 12px;border-radius:30px;display:inline-block}.hero h1{font-size:clamp(38px,5vw,60px);line-height:1.05;letter-spacing:-2px;margin:18px 0}.hero h1 span{color:var(--o)}.hero p{color:var(--muted);font-size:17px;line-height:1.7;max-width:600px}.hero-art{min-height:320px;border-radius:28px;background:linear-gradient(145deg,#d6eadb,#f7e9d8);display:grid;place-items:center;position:relative;overflow:hidden}.hero-art:before{content:'DAYBNB';font-size:clamp(38px,6vw,76px);font-weight:1000;color:#ffffffa8;letter-spacing:4px}.float{position:absolute;background:#fff;padding:12px 16px;border-radius:12px;box-shadow:0 8px 25px #12331b18;font-weight:800;font-size:13px}.f1{left:18px;bottom:25px}.f2{right:18px;top:25px}
section{padding:48px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.section-head h2{margin:0 0 7px;font-size:30px;color:var(--g)}.section-head p{margin:0;color:var(--muted)}.modes{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.mode{padding:22px;border:1px solid var(--line);border-radius:16px;background:#fff}.mode b{font-size:18px;color:var(--g)}.mode p{color:var(--muted);line-height:1.6;font-size:14px}.toolbar{display:grid;grid-template-columns:1.2fr 1fr 1fr auto;gap:10px;margin:20px 0}.toolbar input,.toolbar select,.form input,.form select,.form textarea{width:100%;padding:12px;border:1px solid #ccd8ce;border-radius:9px;background:#fff}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.stay{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#fff}.stay img{width:100%;height:190px;object-fit:cover;background:#e9f0ea}.stay-placeholder{height:190px;background:linear-gradient(135deg,#dcebe0,#f5e5d2);display:grid;place-items:center;color:var(--g);font-size:40px}.stay-body{padding:17px}.stay-body h3{margin:0 0 7px;color:var(--g)}.muted{color:var(--muted);font-size:13px}.rates{display:flex;flex-wrap:wrap;gap:7px;margin:13px 0}.rate{background:#edf5ef;color:var(--g);padding:7px 9px;border-radius:8px;font-size:12px;font-weight:800}.empty{padding:28px;text-align:center;border:1px dashed #cad8ce;border-radius:14px;color:var(--muted);grid-column:1/-1}.panel{background:#f6f9f6;border:1px solid var(--line);border-radius:18px;padding:24px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form label{font-size:12px;font-weight:800;display:block;margin-bottom:6px}.form .full{grid-column:1/-1}.form textarea{min-height:90px;resize:vertical}.hint{font-size:12px;color:var(--muted);line-height:1.5}.form button{width:100%;margin-top:12px}.booking-modal{display:none;position:fixed;inset:0;background:#0b2116b5;z-index:30;padding:16px;align-items:center;justify-content:center}.booking-modal.show{display:flex}.modal-box{width:min(620px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:18px;padding:23px}.modal-head{display:flex;justify-content:space-between;align-items:center;gap:12px}.modal-head h2{color:var(--g);margin:0}.close{background:#edf3ee;color:var(--g);border:0;border-radius:8px;padding:9px;cursor:pointer}.form .hint{margin-top:9px}.notice{padding:12px;border-radius:10px;background:#eaf4ec;color:var(--g);font-size:13px;line-height:1.5;margin:12px 0}.footer{background:#f4f7f4;padding:28px 0;color:var(--muted);font-size:13px}.footer-row{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer img{width:170px;max-height:55px;object-fit:contain}.admin-link{font-size:12px;color:#758078;text-decoration:underline}
@media(max-width:850px){.hero-grid{grid-template-columns:1fr}.toolbar{grid-template-columns:1fr 1fr}.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.nav{height:auto;min-height:68px;flex-wrap:wrap;padding:10px 0}.brand img{width:160px}.navlinks{gap:12px;font-size:12px}.hero{padding:40px 0}.hero-art{min-height:220px}.modes,.cards{grid-template-columns:1fr}.toolbar,.form-grid{grid-template-columns:1fr}.form .full{grid-column:auto}.section-head{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="brand" href="index.html"><img src="jameenghar-logo.png" alt="JameenGhar.com"></a><nav class="navlinks"><a href="index.html">JameenGhar Home</a><a href="#stays">Explore stays</a><a href="#list">List your property</a><a class="btn green" href="daybnb-admin.html">Owner Admin</a></nav></div></header>
<main>
<section class="hero"><div class="wrap hero-grid"><div><span class="eyebrow">DAYBNB BY JAMEENGHAR</span><h1>Your space.<br><span>Your day. Your stay.</span></h1><p>Book a private space for a few hours, enjoy a full day out, or stay overnight. Discover villas, farmhouses, apartments and private rooms.</p><a class="btn" href="#stays">Explore Daybnb</a> <a class="btn outline" href="#list">List your property</a></div><div class="hero-art"><span class="float f1">Hourly access</span><span class="float f2">Day use · Overnight</span></div></div></section>
<section><div class="wrap"><div class="section-head"><div><h2>Choose how you want to stay</h2><p>Three booking options, one simple place to discover.</p></div></div><div class="modes"><article class="mode"><b>◷ Hourly Access</b><p>Book a property for selected hours. The owner sets the hourly price and available times.</p></article><article class="mode"><b>☀ Day Use</b><p>Reserve a space for the day without an overnight stay. The owner sets a day-use rate.</p></article><article class="mode"><b>☾ Overnight Stay</b><p>Book one or more nights. The owner sets the per-night rate and check-in / check-out times.</p></article></div></div></section>
<section id="stays"><div class="wrap"><div class="section-head"><div><h2>Explore Daybnb properties</h2><p>Only owner-approved and published listings appear here.</p></div></div><div class="toolbar"><input id="searchCity" placeholder="Search city or locality"><select id="stayType"><option value="">All property types</option><option>Villa</option><option>Farmhouse</option><option>Apartment</option><option>Private Room</option><option>Resort</option><option>Other</option></select><select id="stayMode"><option value="">All booking types</option><option value="hourly">Hourly access</option><option value="day">Day use</option><option value="overnight">Overnight</option></select><button class="btn green" id="searchBtn">Search</button></div><div id="stayCards" class="cards"><div class="empty">Loading approved Daybnb listings...</div></div></div></section>
<section id="list"><div class="wrap"><div class="section-head"><div><h2>List your property on Daybnb</h2><p>Set your own hourly, day-use and overnight rates. Your listing goes live only after JameenGhar Owner approval.</p></div></div><div class="panel"><form class="form" id="listingForm"><div class="form-grid">
<div><label>Owner full name *</label><input name="ownerName" required maxlength="100"></div><div><label>Mobile number *</label><input name="ownerPhone" required inputmode="numeric" pattern="[0-9]{10}" maxlength="10" placeholder="10 digit mobile"></div>
<div><label>Email *</label><input name="ownerEmail" type="email" required maxlength="150"></div><div><label>Property title *</label><input name="title" required maxlength="120" placeholder="Private farmhouse with pool"></div>
<div><label>Property type *</label><select name="propertyType" required><option value="">Choose</option><option>Villa</option><option>Farmhouse</option><option>Apartment</option><option>Private Room</option><option>Resort</option><option>Other</option></select></div><div><label>Maximum guests *</label><input name="maxGuests" type="number" min="1" max="50" required value="2"></div>
<div><label>City *</label><input name="city" required maxlength="80" placeholder="Jaipur"></div><div><label>Locality / area *</label><input name="locality" required maxlength="100"></div>
<div><label>Hourly rate (₹) *</label><input name="hourlyRate" type="number" min="1" max="1000000" required></div><div><label>Day-use rate (₹) *</label><input name="dayRate" type="number" min="1" max="1000000" required></div>
<div><label>Overnight rate (₹ / night) *</label><input name="nightRate" type="number" min="1" max="1000000" required></div><div><label>Check-in time</label><input name="checkInTime" type="time" value="14:00"></div>
<div><label>Check-out time</label><input name="checkOutTime" type="time" value="11:00"></div><div><label>Cover image URL (optional)</label><input name="coverImage" type="url" placeholder="https://..."></div>
<div class="full"><label>Additional photo URLs (optional, one URL per line)</label><textarea name="imageUrls" placeholder="https://...&#10;https://..."></textarea></div>
<div class="full"><label>Amenities</label><input name="amenities" placeholder="Swimming pool, parking, AC, kitchen"></div>
<div class="full"><label>Property description *</label><textarea name="description" required maxlength="1200" placeholder="Describe the space, facilities, rules and availability."></textarea></div>
<div class="full"><label>Exact address (kept private until owner review)</label><input name="address" maxlength="250" placeholder="Full address for verification"></div>
<div class="full"><button class="btn" type="submit" id="listSubmit">Submit property for approval</button></div></div><p class="hint">Important: This initial version accepts public image links; it does not upload image files or identity documents. OTP verification, document upload, online payments and calendar-based instant availability are not enabled yet. Do not share sensitive ID documents in this form. JameenGhar will contact you to complete verification before publication.</p><p id="listingMessage" class="notice" aria-live="polite" style="display:none"></p></form></div></div></section>
</main>
<footer class="footer"><div class="wrap footer-row"><div><img src="jameenghar-logo.png" alt="JameenGhar"><p>Daybnb — Hourly access, day use and overnight stays.</p></div><div><a href="index.html">Back to JameenGhar</a><p><a href="mailto:support@jameenghar.com">support@jameenghar.com</a></p><a class="admin-link" href="daybnb-admin.html">Owner administration</a></div></div></footer>
<div class="booking-modal" id="bookingModal"><div class="modal-box"><div class="modal-head"><h2 id="bookingTitle">Request a booking</h2><button class="close" id="closeBooking">✕</button></div><p id="bookingProperty" class="muted"></p><form class="form" id="bookingForm"><input type="hidden" name="propertyId"><input type="hidden" name="propertyTitle"><div class="form-grid"><div><label>Booking type *</label><select name="bookingType" id="bookingType" required><option value="hourly">Hourly access</option><option value="day">Day use</option><option value="overnight">Overnight</option></select></div><div><label>Guests *</label><input name="guests" type="number" min="1" max="50" value="2" required></div><div><label>Check-in date *</label><input name="checkInDate" type="date" required></div><div><label>Check-out date *</label><input name="checkOutDate" type="date" required></div><div><label>Start time *</label><input name="startTime" type="time" value="10:00" required></div><div><label>End time *</label><input name="endTime" type="time" value="12:00" required></div><div><label>Your name *</label><input name="customerName" required maxlength="100"></div><div><label>Mobile number *</label><input name="phone" required pattern="[0-9]{10}" maxlength="10" inputmode="numeric"></div><div class="full"><label>Email</label><input name="email" type="email" maxlength="150"></div><div class="full"><label>Message / special request</label><textarea name="message" maxlength="500"></textarea></div></div><div class="notice" id="quoteBox">Estimated amount will appear here. This is a booking request, not a confirmed reservation or payment.</div><button class="btn" id="bookingSubmit" type="submit">Send booking request</button><p class="hint">The property owner must confirm availability and price. No online payment is collected on this page.</p></form></div></div>
<script type="module">
import {initializeApp} from 'https://www.gstatic.com/firebasejs/12.5.0/firebase-app.js';
import {getFirestore,collection,addDoc,getDocs,query,where,serverTimestamp,doc,writeBatch} from 'https://www.gstatic.com/firebasejs/12.5.0/firebase-firestore.js';
const firebaseConfig={apiKey:'AIzaSyCLqBPwR6LfBHRe-pplNaRvztujCEOy2l8',authDomain:'jameenghar-ffdfd.firebaseapp.com',projectId:'jameenghar-ffdfd',storageBucket:'jameenghar-ffdfd.firebasestorage.app',messagingSenderId:'554797022939',appId:'1:554797022939:web:5abc3fd7e68ea6aeca56fe',measurementId:'G-RQJWG3PBY9'};
const app=initializeApp(firebaseConfig);const db=getFirestore(app);const $=id=>document.getElementById(id);let stays=[];let selectedStay=null;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const money=n=>'₹'+Number(n||0).toLocaleString('en-IN');
async function loadStays(){try{const snap=await getDocs(query(collection(db,'daybnbProperties'),where('isPublished','==',true)));stays=snap.docs.map(d=>({id:d.id,...d.data()}));renderStays()}catch(e){console.error(e);$('stayCards').innerHTML='<div class="empty">Could not load listings. Please refresh or try again later.</div>';}}
function renderStays(){const city=$('searchCity').value.trim().toLowerCase(),type=$('stayType').value,mode=$('stayMode').value;const list=stays.filter(p=>(!city||((p.city||'')+' '+(p.locality||'')).toLowerCase().includes(city))&&(!type||p.propertyType===type)&&(!mode||Number(p[mode==='hourly'?'hourlyRate':mode==='day'?'dayRate':'nightRate'])>0));$('stayCards').innerHTML=list.length?list.map(p=>`<article class="stay">${p.coverImage?`<img src="${esc(p.coverImage)}" alt="${esc(p.title)}" loading="lazy">`:'<div class="stay-placeholder">⌂</div>'}<div class="stay-body"><h3>${esc(p.title)}</h3><div class="muted">${esc(p.propertyType)} · ${esc(p.locality)}, ${esc(p.city)}</div><p class="muted">Up to ${esc(p.maxGuests||'—')} guests</p><div class="rates"><span class="rate">${money(p.hourlyRate)} / hour</span><span class="rate">${money(p.dayRate)} / day</span><span class="rate">${money(p.nightRate)} / night</span></div><p class="muted">${esc(p.description||'')}</p><button class="btn green book-btn" data-id="${esc(p.id)}">Request booking</button></div></article>`).join(''):'<div class="empty">No approved Daybnb properties match your search yet. Please check again soon.</div>';}
function getQuote(){if(!selectedStay)return 0;const f=new FormData($('bookingForm'));const type=f.get('bookingType'),start=f.get('startTime'),end=f.get('endTime'),d1=f.get('checkInDate'),d2=f.get('checkOutDate');if(type==='hourly'){if(!start||!end)return 0;const [sh,sm]=start.split(':').map(Number),[eh,em]=end.split(':').map(Number);let hours=(eh*60+em-sh*60-sm)/60;if(hours<=0)return 0;return Math.ceil(hours)*Number(selectedStay.hourlyRate||0);}if(type==='day')return Number(selectedStay.dayRate||0);if(!d1||!d2)return 0;const nights=(new Date(d2+'T00:00:00')-new Date(d1+'T00:00:00'))/86400000;if(nights<=0)return 0;return nights*Number(selectedStay.nightRate||0);}
function updateQuote(){const f=$('bookingForm'),type=$('bookingType').value;f.elements.checkOutDate.required=type==='overnight';f.elements.startTime.required=type==='hourly';f.elements.endTime.required=type==='hourly';const q=getQuote();$('quoteBox').textContent=q>0?'Estimated amount: '+money(q)+' (owner confirmation required; no payment collected).':'Choose valid dates and times to calculate an estimate.';}
function openBooking(p){selectedStay=p;const f=$('bookingForm');f.reset();f.elements.propertyId.value=p.id;f.elements.propertyTitle.value=p.title;$('bookingProperty').textContent=p.title+' · '+p.locality+', '+p.city;$('bookingModal').classList.add('show');updateQuote();}
$('stayCards').addEventListener('click',e=>{const b=e.target.closest('.book-btn');if(!b)return;const p=stays.find(x=>x.id===b.dataset.id);if(p)openBooking(p)});$('searchBtn').addEventListener('click',renderStays);$('stayMode').addEventListener('change',renderStays);$('stayType').addEventListener('change',renderStays);$('searchCity').addEventListener('input',renderStays);$('closeBooking').addEventListener('click',()=>$('bookingModal').classList.remove('show'));$('bookingType').addEventListener('change',updateQuote);$('bookingForm').addEventListener('input',updateQuote);
$('listingForm').addEventListener('submit',async e=>{e.preventDefault();const f=e.target,data=new FormData(f),btn=$('listSubmit');const phone=String(data.get('ownerPhone')||'').replace(/\D/g,'');if(!/^\d{10}$/.test(phone)){alert('Please enter a valid 10-digit mobile number.');return;}const images=String(data.get('imageUrls')||'').split(/\n|,/).map(x=>x.trim()).filter(Boolean).slice(0,5);const cover=String(data.get('coverImage')||'').trim();if(cover&&!/^https:\/\//i.test(cover)){alert('Cover image must use an https:// link.');return;}if(images.some(x=>!/^https:\/\//i.test(x))){alert('Each additional image must use an https:// link.');return;}btn.disabled=true;btn.textContent='Submitting...';try{const listingData={title:String(data.get('title')).trim(),propertyType:String(data.get('propertyType')),maxGuests:Number(data.get('maxGuests')),city:String(data.get('city')).trim(),locality:String(data.get('locality')).trim(),hourlyRate:Number(data.get('hourlyRate')),dayRate:Number(data.get('dayRate')),nightRate:Number(data.get('nightRate')),checkInTime:String(data.get('checkInTime')||'14:00'),checkOutTime:String(data.get('checkOutTime')||'11:00'),coverImage:cover,imageUrls:images,amenities:String(data.get('amenities')||'').split(',').map(x=>x.trim()).filter(Boolean).slice(0,15),description:String(data.get('description')).trim(),status:'pending',isPublished:false,createdAt:serverTimestamp(),updatedAt:serverTimestamp()};const listingRef=doc(collection(db,'daybnbProperties'));const privateRef=doc(db,'daybnbPrivate',listingRef.id);const batch=writeBatch(db);batch.set(listingRef,listingData);batch.set(privateRef,{propertyId:listingRef.id,ownerName:String(data.get('ownerName')).trim(),ownerPhone:phone,ownerEmail:String(data.get('ownerEmail')).trim(),address:String(data.get('address')||'').trim(),createdAt:serverTimestamp()});await batch.commit();f.reset();$('listingMessage').style.display='block';$('listingMessage').textContent='Thank you. Your Daybnb property has been submitted for JameenGhar review. It will appear publicly only after approval.';f.scrollIntoView({behavior:'smooth',block:'center'});}catch(err){console.error(err);alert('Could not submit property: '+err.message);}finally{btn.disabled=false;btn.textContent='Submit property for approval';}});
$('bookingForm').addEventListener('submit',async e=>{e.preventDefault();const f=e.target,data=new FormData(f),btn=$('bookingSubmit');const phone=String(data.get('phone')||'').replace(/\D/g,'');const quote=getQuote();if(!/^\d{10}$/.test(phone)){alert('Please enter a valid 10-digit mobile number.');return;}if(!quote){alert('Please select valid booking dates and times.');return;}const guests=Number(data.get('guests'));if(guests>Number(selectedStay.maxGuests||50)){alert('Guest count exceeds this property maximum.');return;}btn.disabled=true;btn.textContent='Sending...';try{await addDoc(collection(db,'daybnbBookings'),{propertyId:selectedStay.id,propertyTitle:selectedStay.title,ownerName:selectedStay.ownerName||'',ownerPhone:selectedStay.ownerPhone||'',customerName:String(data.get('customerName')).trim(),phone,email:String(data.get('email')||'').trim(),bookingType:String(data.get('bookingType')),checkInDate:String(data.get('checkInDate')),checkOutDate:String(data.get('checkOutDate')),startTime:String(data.get('startTime')||''),endTime:String(data.get('endTime')||''),guests,quotedTotal:quote,message:String(data.get('message')||'').trim(),status:'pending',createdAt:serverTimestamp()});f.reset();$('bookingModal').classList.remove('show');alert('Booking request sent. The property owner / JameenGhar team will contact you to confirm availability and payment.');}catch(err){console.error(err);alert('Could not send booking request: '+err.message);}finally{btn.disabled=false;btn.textContent='Send booking request';}});
loadStays();
</script>
</body></html>
